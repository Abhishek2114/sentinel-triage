# ── Database ──────────────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinel
# These point at localhost for running the API on your machine (README quick start).
# docker-compose.yml overrides them with the container hostnames.
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@localhost:5432/sentinel

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── LLM / Embeddings ─────────────────────────────────
# Leave both empty to triage without an LLM (rule-based reports).
# Any OpenAI-compatible endpoint works, e.g. LLM_BASE_URL=http://localhost:11434/v1 (Ollama).
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# 384-d sentence-transformers model, or "hashing" to run fully offline
EMBEDDING_MODEL=all-MiniLM-L6-v2
RUNBOOKS_DIR=data/runbooks

# ── App ───────────────────────────────────────────────
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DEBUG=true
AUTO_CREATE_TABLES=true
INGEST_ROOT=data

# ── Detection schedule (Celery beat) ─────────────────
DETECTION_INTERVAL_SECONDS=300
DETECTION_LOOKBACK_MINUTES=360
# Detectors whose anomalies become incidents (JSON list)
TRIAGE_DETECTORS=["error_burst"]
