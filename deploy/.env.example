# Production settings for deploy/docker-compose.prod.yml.
# Copy to deploy/.env (never committed) and fill in every <...> value.

# ── Public address ────────────────────────────────────
# The domain or subdomain whose DNS A record points at this server
DOMAIN=<sentinel.example.com>
# Let's Encrypt sends certificate expiry warnings here
ACME_EMAIL=<you@example.com>

# ── Secrets (generate each with: openssl rand -hex 32) ─
POSTGRES_PASSWORD=<hex string>
# Needed for every write (ingest, detect, triage, resolve). JSON list; the
# server refuses to start in production without at least one key.
API_KEYS=["<hex string>"]

# ── Public demo ───────────────────────────────────────
# Anyone may read incidents and press "Run demo"; writes still need a key
DEMO_MODE=true
# One demo run per this many seconds, across the whole server
DEMO_COOLDOWN_SECONDS=60

# ── LLM (optional) ────────────────────────────────────
# Left as is, triage writes a rule-based report and no LLM is called. To use
# one, uncomment a provider. The daily limits below cap spend no matter how
# often visitors press "Run demo".
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Or any OpenAI-compatible endpoint:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
LLM_MAX_CALLS_PER_DAY=100
LLM_MAX_TOKENS_PER_DAY=300000

# ── Size for the server ──────────────────────────────
# "hashing" needs no model download and little memory. Runbook retrieval
# uses BM25 by default, which found the right runbook equally often with
# either embedder (README "Retrieval"). Use all-MiniLM-L6-v2 on 4 GB+.
EMBEDDING_MODEL=hashing
# API processes and Celery worker processes
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2

LOG_LEVEL=INFO
